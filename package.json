{
  "name": "orbit",
  "private": true,
  "version": "0.1.0",
  "description": "A music player built in TypeScript on top of a doubly linked list. Search any song, queue it at the start, the end or any position, and play it in full while a 3D particle sphere reacts to the music and to your cursor.",
  "type": "module",
  "author": "Juan Camilo López Díaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juansit-0/ORBIT.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
